# Storage and public URLs
GAUSSI_DATA_DIR=/var/lib/gaussi
GAUSSI_PUBLIC_BASE_URL=https://api.example.com
GAUSSI_FRONTEND_ORIGINS=https://your-vercel-app.vercel.app,http://localhost:5173
GAUSSI_MAX_UPLOAD_MB=4096
GAUSSI_JOB_WORKERS=1

# Binaries installed on the GCP VM
GAUSSI_FFMPEG_BIN=/usr/bin/ffmpeg
GAUSSI_COLMAP_BIN=/usr/local/bin/colmap
GAUSSI_OPENSLAT_BIN=/usr/local/bin/opensplat

# Local-only helper when COLMAP/OpenSplat are not installed.
GAUSSI_PIPELINE_DRY_RUN=false

# CPU-friendly defaults for c3d-standard-4. Adjust once real data tells us more.
GAUSSI_FRAME_RATE=3
GAUSSI_MAX_FRAME_WIDTH=1600
GAUSSI_COLMAP_USE_GPU=0
GAUSSI_COLMAP_RUN_VIEW_GRAPH_CALIBRATOR=true
GAUSSI_OPENSLAT_ITERATIONS=7000

# Command templates. Values in braces are filled by the backend.
GAUSSI_FFMPEG_TEMPLATE="{ffmpeg} -y -i {input_video} -vf fps={frame_rate},scale={max_frame_width}:-2 {frames_dir}/frame_%06d.png"
GAUSSI_COLMAP_FEATURE_TEMPLATE="{colmap} feature_extractor --database_path {database_path} --image_path {frames_dir} --ImageReader.single_camera 1 --FeatureExtraction.use_gpu {colmap_use_gpu}"
GAUSSI_COLMAP_MATCH_TEMPLATE="{colmap} exhaustive_matcher --database_path {database_path} --FeatureMatching.use_gpu {colmap_use_gpu}"
GAUSSI_COLMAP_CALIBRATOR_TEMPLATE="{colmap} view_graph_calibrator --database_path {mapper_database_path}"
GAUSSI_COLMAP_MAPPER_TEMPLATE="{colmap} global_mapper --database_path {mapper_database_path} --image_path {frames_dir} --output_path {sparse_dir}"
GAUSSI_OPENSLAT_TEMPLATE="{opensplat} {colmap_workspace} -n {opensplat_iterations} -o {output_ply}"
